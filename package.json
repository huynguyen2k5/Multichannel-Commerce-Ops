{
  "name": "multichannel-commerce-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" --kill-others \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "start": "pnpm dev",
    "dev:frontend": "pnpm --filter mco-frontend dev",
    "dev:backend": "node scripts/dev-backend.js",
    "build": "pnpm --filter mco-frontend build",
    "lint": "pnpm --filter mco-frontend lint",
    "test": "pnpm --filter mco-frontend test"
  },
  "devDependencies": {
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "concurrently": "^10.0.5"
  }
}
