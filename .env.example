# ==============================================================================
# Multichannel Commerce Ops (MCO) - Environment Configuration Template
# Copy this file to .env and customize for local or containerized development.
# ==============================================================================

# Core Application
MCO_ENVIRONMENT=development
MCO_LOG_LEVEL=INFO
MCO_API_PREFIX=/api/v1
MCO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL / Neon)
# In Docker Compose, service name "postgres" is used by default.
# For Neon, provide your pooled asyncpg URL and unpooled psycopg URL.
MCO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mco
MCO_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mco

# n8n Automation Engine
N8N_ENCRYPTION_KEY=dcfb03d851d22ec14a67d3f04b31db76119242d6e565645a06fba61114272a63
MCO_API_BASE_URL=http://localhost:8000

# Optional: Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: External Mock Channel Credentials
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_REPORT_DATE=2026-09-01
