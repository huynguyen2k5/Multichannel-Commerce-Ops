          <mxGeometry x="60" y="88" width="1930" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;font-size:18px;font-weight:700;line-height:1.2;padding-bottom:8px;margin-bottom:10px;border-bottom:2px solid #666666;&quot;&gt;multichannel-commerce-ops/&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.48;&quot;&gt;backend/app/modules/&lt;br/&gt;&#10;&amp;nbsp;&amp;nbsp;channels/ products/ orders/ inventory/&lt;br/&gt;&#10;&amp;nbsp;&amp;nbsp;ledger/ reports/ alerts/ reconciliation/&lt;br/&gt;&#10;&amp;nbsp;&amp;nbsp;mock_channels/&lt;br/&gt;&#10;backend/alembic/&lt;br/&gt;&#10;backend/tests/unit + integration/&lt;br/&gt;&#10;frontend/src/api + features + pages/&lt;br/&gt;&#10;n8n/&lt;br/&gt;&#10;docs/architecture + adr/&lt;br/&gt;&#10;infra/&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=20;spacingTop=18;spacingLeft=20;spacingRight=20;spacingBottom=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="90" y="185" width="720" height="650" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&quot;font-size:18px;font-weight:700;line-height:1.2;padding-bottom:8px;margin-bottom:10px;border-bottom:2px solid #6c8ebf;&quot;&gt;Implementation slices&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.48;&quot;&gt;0. Repository foundation&lt;br/&gt;&#10;1. Database connection + Alembic&lt;br/&gt;&#10;2. Channels&lt;br/&gt;&#10;3. Products&lt;br/&gt;&#10;4. Deterministic mock channels&lt;br/&gt;&#10;5. Order persistence&lt;br/&gt;&#10;6. Idempotent import&lt;br/&gt;&#10;7. Inventory consumption&lt;br/&gt;&#10;8. Ledger generation&lt;br/&gt;&#10;9. Atomic transaction tests&lt;br/&gt;&#10;10. Daily report&lt;br/&gt;&#10;11. n8n order sync&lt;br/&gt;&#10;12-13. Alerts + Telegram&lt;br/&gt;&#10;14-16. Reconciliation&lt;br/&gt;&#10;17-20. React dashboard&lt;br/&gt;&#10;21-22. Deployment + runbook&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=20;spacingTop=18;spacingLeft=20;spacingRight=20;spacingBottom=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="970" y="185" width="720" height="650" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;font-size:14px;line-height:1.45;&quot;&gt;Rule for AI coding agents: implement one slice at a time. Do not implement an entire sprint in one change. Each slice needs tests and an architecture/doc update if its contract changes.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=middle;spacing=14;shape=note;size=15;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;" vertex="1" parent="1">
